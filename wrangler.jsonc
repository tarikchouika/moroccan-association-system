{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mamp-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "alias": {
    // Next 16 يُبقي @prisma/client خارجياً افتراضياً باسم مجزّأ (‎-2c3a283f134fdcb6)
    // لا يحلّه wrangler — نعيد توجيهه لملف التشغيل الحقيقي في node_modules.
    "@prisma/client-2c3a283f134fdcb6/runtime/wasm-engine-edge": "./node_modules/@prisma/client/runtime/wasm-engine-edge.mjs"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mamp-db",
      "database_id": "4c68272b-e9fc-41d3-bc19-0a0e70e71cc1",
      "migrations_dir": "d1/migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
