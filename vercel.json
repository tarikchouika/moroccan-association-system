{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bash scripts/build-static.sh",
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/((?!mamp-site-latest\\.zip).*)",
      "destination": "https://mamp.pages.dev/$1",
      "permanent": false
    }
  ]
}
